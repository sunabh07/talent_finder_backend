# ---------------------------------------------------------------------------
# Talent Finder - backend environment
# Copy to .env and adjust. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection (SQLAlchemy / psycopg v3 URL)
DATABASE_URL=postgresql+psycopg://talentfinder:talentfinder_dev@localhost:5432/talentfinder

# Separate database used by the pytest suite. It is dropped and recreated
# per test session, so never point this at the development database.
TEST_DATABASE_URL=postgresql+psycopg://talentfinder:talentfinder_dev@localhost:5432/talentfinder_test

# Application
APP_NAME=Talent Finder API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS - comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pagination defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# CV upload limits (Story 2)
MAX_CV_SIZE_MB=10

# Optional CV autofill. Use fictional CVs with unpaid Gemini access.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
